# ====================================
# Application
# ====================================

APP_NAME=AI Anti Scam Chatbot

APP_VERSION=1.0.0

ENVIRONMENT=development

DEBUG=true

HOST=0.0.0.0

PORT=8000


# ====================================
# Gemini
# ====================================

GEMINI_API_KEY=YOUR_GEMINI_API_KEY

GEMINI_MODEL=gemini-2.5-flash


# ====================================
# Redis
# ====================================

REDIS_URL=redis://localhost:6379

REDIS_DB=0


# ====================================
# Pinecone
# ====================================

PINECONE_API_KEY=YOUR_PINECONE_API_KEY

PINECONE_INDEX=anti-scam-chatbot

PINECONE_NAMESPACE_LAW=law

PINECONE_NAMESPACE_SCAM=scam


# ====================================
# Embedding
# ====================================

EMBEDDING_MODEL=intfloat/multilingual-e5-large


# ====================================
# Retrieval
# ====================================

TOP_K=5


# ====================================
# Cache
# ====================================

CACHE_TTL=21600


# ====================================
# HTTP
# ====================================

REQUEST_TIMEOUT=10