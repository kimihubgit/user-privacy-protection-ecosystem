# ============================
# Server
# ============================
PORT=8003
CORS_ORIGIN=http://localhost:5173

# ============================
# Google Gemini
# ============================
GEMINI_API_KEY=your-gemini-api-key
# Model dùng để sinh câu trả lời
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Model dùng để tạo embedding cho câu hỏi.
# QUAN TRỌNG: phải TRÙNG với model đã dùng để tạo embedding
# cho dữ liệu đang lưu trong Pinecone, nếu không kết quả tìm kiếm sẽ sai lệch.
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768

# ============================
# Pinecone
# ============================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-index-name
# Để trống nếu index không dùng namespace
PINECONE_NAMESPACE=
# Số lượng đoạn văn bản (chunk) lấy về để làm ngữ cảnh
PINECONE_TOP_K=5
# Ngưỡng điểm tương đồng tối thiểu (0-1, cosine). Kết quả thấp hơn sẽ bị loại.
PINECONE_MIN_SCORE=0.72
# Tên field trong metadata chứa nội dung văn bản gốc của chunk
PINECONE_TEXT_FIELD=text
