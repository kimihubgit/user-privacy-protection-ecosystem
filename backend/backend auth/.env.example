# Server settings
PORT=8081

# Database settings
MONGO_URI=mongodb://localhost:27017
MONGO_DB=protect_user_auth

# JWT RSA Keys (Paste PEM strings with literal newlines or escaped \n)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# WebAuthn (Passkeys) settings
RP_DISPLAY_NAME="Protect User Auth"
RP_ID="localhost"
RP_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8081,http://localhost:8080"
